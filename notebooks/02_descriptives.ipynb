    "def  hourlyEnergyDelivered(df,\n",
    "                                  conn_col='connectionTime',\n",
    "                                  done_col='doneChargingTime',\n",
    "                                  kwh_col='kWhDelivered',\n",
    "                                  duration_col='charging_duration',\n",
    "                                  site_col=None):\n",
    "   \n",
    "    df = df.copy()\n",
    "    df[conn_col] = pd.to_datetime(df[conn_col], errors='coerce')\n",
    "    df[done_col] = pd.to_datetime(df[done_col], errors='coerce')\n",
    "\n",
    "    minutes_per_bin = 60  # für stündliche Aufteilung\n",
    "\n",
    "    def row_hour_kwh(row):\n",
    "        start = row[conn_col]\n",
    "        end = row[done_col]  # Ladeende\n",
    "        kwh_total = row[kwh_col]\n",
    "        duration = row[duration_col]  # in Minuten\n",
    "        if site_col:\n",
    "            site = row[site_col]\n",
    "\n",
    "        if pd.isna(start) or pd.isna(end) or end <= start or pd.isna(kwh_total) or duration <= 0:\n",
    "            return []\n",
    "\n",
    "        bins = pd.date_range(\n",
    "            start=start.floor('h'),\n",
    "            end=(end - pd.Timedelta(seconds=1)).floor('h'),\n",
    "            freq='h'\n",
    "        )\n",
    "\n",
    "        out = []\n",
    "        for b in bins:\n",
    "            b_start = max(start, b)\n",
    "            b_end = min(end, b + pd.Timedelta(minutes=minutes_per_bin))\n",
    "            hours_in_bin = (b_end - b_start).total_seconds() / 3600.0\n",
    "            if hours_in_bin > 0:\n",
    "                # kWh proportional zur Dauer in der Stunde\n",
    "                kwh_in_hour = kwh_total * (hours_in_bin / (duration))\n",
    "                out.append({\n",
    "                    'date': b,\n",
    "                    'energy_delivered': kwh_in_hour,\n",
    "                    'site': site if site_col else None\n",
    "\n",
    "                })\n",
    "        return out\n",
    "\n",
    "    contrib = df.apply(row_hour_kwh, axis=1)\n",
    "    tmp = pd.DataFrame([item for lst in contrib for item in lst])\n",
    "\n",
    "    if tmp.empty:\n",
    "        return pd.DataFrame(columns=['year', 'hour', 'site', 'energy_delivered'])\n",
    "    tmp['year'] = tmp['date'].dt.year\n",
    "    tmp['hour'] = tmp['date'].dt.hour\n",
    "\n",
    "    # stündliche Aggregation\n",
    "    if site_col:\n",
    "        out = tmp.groupby(['hour', 'site'], as_index=False).agg(energy_delivered=('energy_delivered', 'sum'))\n",
    "    else:\n",
    "        out = tmp.groupby(['year', 'hour'], as_index=False).agg(energy_delivered=('energy_delivered', 'sum'))\n",
    "\n",
    "    return out"
   ]
