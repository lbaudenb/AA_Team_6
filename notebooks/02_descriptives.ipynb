    "# function to create utilization per hour or day\n",
    "def calculate_utilization(df,\n",
    "                               freq,\n",
    "                               conn_col='connectionTime',\n",
    "                               disc_col='disconnectTime',\n",
    "                               **kwargs):\n",
    "    df = df.copy()\n",
    "    df[conn_col] = pd.to_datetime(df[conn_col], errors='coerce')\n",
    "    df[disc_col] = pd.to_datetime(df[disc_col], errors='coerce')\n",
    "\n",
    "    n_stations = df['stationID'].nunique()\n",
    "\n",
    "\n",
    "    minutes_per_bin = {\n",
    "        'h': 60,\n",
    "        'd': 24 * 60,\n",
    "    }[freq]\n",
    "\n",
    "    # function to calculate hourly contributions for each charging session\n",
    "    def row_hour_contrib(row):\n",
    "        start = row[conn_col]\n",
    "        end = row[disc_col]\n",
    "        if pd.isna(start) or pd.isna(end) or end <= start:\n",
    "            return []\n",
    "\n",
    "        bins = pd.date_range(\n",
    "            start=start.floor(freq),\n",
    "            end=(end - pd.Timedelta(seconds=1)).floor(freq),\n",
    "            freq=freq\n",
    "        )\n",
    "\n",
    "        out = []\n",
    "        for b in bins:\n",
    "            b_start = max(start, b)\n",
    "            b_end = min(end, b + pd.Timedelta(minutes=minutes_per_bin))\n",
    "            minutes = (b_end - b_start).total_seconds() / 60.0\n",
    "            if minutes > 0:\n",
    "                # append hourly contribution\n",
    "                out.append({\n",
    "                    'date': b,\n",
    "                    'minutes': minutes,\n",
    "\n",
    "                })\n",
    "        return out\n",
    "\n",
    "    contrib = df.apply(row_hour_contrib, axis=1)\n",
    "    tmp = pd.DataFrame([item for lst in contrib for item in lst])\n",
    "\n",
    "    if tmp.empty:\n",
    "        if freq == 'h':\n",
    "            return pd.DataFrame(columns=[\n",
    "                'hour', \n",
    "                'hourly_utilization_minutes', \n",
    "                'utilization_rate',\n",
    "                'dayofweek',\n",
    "        ])\n",
    "        else:\n",
    "            return pd.DataFrame(columns=[\n",
    "                'date', \n",
    "                'utilization_minutes', \n",
    "                'utilization_rate',\n",
    "                'season',\n",
    "                'dayofweek',\n",
    "                'is_weekend'\n",
    "        ])\n",
    "\n",
    "\n",
    "    # Hourly aggregation for session contributions within each hour\n",
    "    out = (\n",
    "        tmp.groupby('date', as_index=False)\n",
    "            .agg(\n",
    "                hourly_utilization_minutes=('minutes', 'sum'),\n",
    "            )\n",
    "    )\n",
    "    # calculate hourly utilization as a fraction of total available minutes\n",
    "    out['utilization_rate'] = (\n",
    "        (out['hourly_utilization_minutes'] / (n_stations * minutes_per_bin)) * 100\n",
    "    ).clip(0, 100)\n",
    "\n",
    "    if freq==\"h\" and kwargs.get('dow', None):\n",
    "        out['dayofweek'] = out['date'].dt.dayofweek\n",
    "        out['hour'] = out['date'].dt.hour\n",
    "        n_days = out['date'].dt.date.nunique()\n",
    "        hourly_profile = (\n",
    "            out.groupby(['dayofweek','hour'], as_index=False)\n",
    "                .agg(\n",
    "                    hourly_utilization_minutes=('hourly_utilization_minutes', 'sum'),\n",
    "                    utilization_rate=('utilization_rate', 'mean'),\n",
    "                )\n",
    "        )    \n",
    "        return hourly_profile\n",
    "    if freq == 'h':\n",
    "        out['hour'] = out['date'].dt.hour\n",
    "        n_days = out['date'].dt.date.nunique()\n",
    "        hourly_profile = (\n",
    "            out.groupby('hour', as_index=False)\n",
    "                .agg(\n",
    "                    hourly_utilization_minutes=('hourly_utilization_minutes', 'sum'),\n",
    "                    utilization_rate=('utilization_rate', 'mean'),\n",
    "                )\n",
    "        )    \n",
    "        return hourly_profile\n",
    "    else:\n",
    "        out = out.rename(columns={'hourly_utilization_minutes': 'utilization_minutes'})\n",
    "\n",
    "    season_labels = {1: 'Winter', 2: 'Spring', 3: 'Summer', 4: 'Fall'}\n",
    "    out['season'] = (out['date'].dt.month % 12 // 3 + 1).map(season_labels)\n",
    "    \n",
    "\n",
    "\n",
    "\n",
    "    out['dayofweek'] = out['date'].dt.dayofweek\n",
    "    out['is_weekend'] = out['dayofweek'] >= 5\n",
    "    return out"
   ]
