    "def calculate_number_of_session_per_day_of_the_week(df):\n",
    "    sessions_per_day = df.groupby(['dayofweek', 'siteID'])['sessionID'].nunique().unstack(fill_value=0)\n",
    "    sessions_per_day.index = sessions_per_day.index.map({0:'Monday', 1:'Tuesday', 2:'Wednesday', 3:'Thursday', 4:'Friday', 5:'Saturday', 6:'Sunday'})\n",
    "    # Reorder days\n",
    "    day_order = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']\n",
    "    sessions_per_day = sessions_per_day.reindex(day_order)\n",
    "    return sessions_per_day\n",
    "\n",
    "sessions_per_day = calculate_number_of_session_per_day_of_the_week(df)\n",
    "print(sessions_per_day)\n",
    "\n",
    "# Create grouped bar chart\n",
    "fig, ax = plt.subplots(figsize=(12, 6))\n",
    "\n",
    "x = np.arange(len(sessions_per_day.index))\n",
    "width = 0.35\n",
    "\n",
    "colors = ['#87CEEB', '#90EE90']  # Colors for sites\n",
    "\n",
    "for idx, site in enumerate(sorted(sessions_per_day.columns)):\n",
    "    offset = (idx - 0.5) * width\n",
    "    ax.bar(x + offset, sessions_per_day[site], width, \n",
    "           label=f'Site {int(site)}', color=colors[idx], \n",
    "           alpha=0.7, edgecolor='black')\n",
    "\n",
    "ax.set_xlabel('Day of Week', fontsize=12)\n",
    "ax.set_ylabel('Number of Sessions', fontsize=12)\n",
    "ax.set_title('Number of Sessions per Day of Week by Site', fontsize=14, fontweight='bold')\n",
    "ax.set_xticks(x)\n",
    "ax.set_xticklabels(sessions_per_day.index, rotation=45, ha='right')\n",
    "ax.legend()\n",
    "ax.grid(axis='y', alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
